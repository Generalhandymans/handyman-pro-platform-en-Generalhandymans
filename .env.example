# Copy to .env and fill in. Never commit a real .env.

# Server
PORT=3000
# REQUIRED in production (the server refuses to start without it).
JWT_SECRET=change-me-to-a-long-random-string
# Set to "production" on the server: turns on fail-fast checks.
NODE_ENV=development
# Public base URL used in emails (verification, unsubscribe links).
PUBLIC_URL=http://localhost:3000
# PostgreSQL (production). Leave empty to use SQLite locally. Migrations run on boot.
DATABASE_URL=
DB_SSL=
DB_PATH=./data/handyman.db

# Vision provider (OpenAI-compatible). If empty, the app runs in heuristic mode:
# photos are stored and linked to the job, and the estimator asks the customer
# to classify the room via the scope questionnaire instead of auto-analyzing.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4o-mini

# Email provider for mass campaigns. Default: "console" (logs to server console
# and stores every message in the email_log table — nothing is really sent).
# Set EMAIL_PROVIDER=sendgrid and SENDGRID_API_KEY to send for real.
EMAIL_PROVIDER=console
SENDGRID_API_KEY=

# BUSINESS SENDER IDENTITY — all platform email (CRM campaigns, notifications)
# goes out from the BUSINESS account, never a personal one.
# Default is the owner-confirmed business address. Override only if the
# business changes its address. Real delivery ALSO requires EMAIL_PROVIDER
# and provider credentials (see README "Business email setup").
HANDYMAN_FROM_EMAIL=generalhandymans@gmail.com
HANDYMAN_FROM_NAME=General Handyman Solutions

# --- First admin + demo data ---
# On first boot with an empty database:
#   - If ADMIN_EMAIL + ADMIN_PASSWORD are set -> creates the real admin.
#   - Else if SEED_DEMO=true -> loads the demo dataset (dev only, NEVER in production).
#   - Else -> boots empty and warns. No demo accounts are ever created silently.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
SEED_DEMO=false

# --- Stripe: real card payments ---
# 1. Create your account at https://dashboard.stripe.com/register
# 2. Developers -> API keys -> copy both keys below
# 3. Developers -> Webhooks -> Add endpoint: https://YOUR-DOMAIN/api/payments/webhook
#    events: payment_intent.succeeded, payment_intent.payment_failed -> copy signing secret
# Without these keys, deposits stay manual (current behavior). Nothing breaks.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# In production Stripe is required: otherwise accepting a quote would mark the
# deposit paid without collecting money. Set true ONLY for a manual-payments pilot.
ALLOW_MANUAL_PAYMENTS=false

# --- Promotional email compliance ---
# Physical postal address shown in the footer of every campaign (required to send real campaigns).
COMPANY_POSTAL_ADDRESS=
# Name shown in email headers.
BRAND_NAME=Helpman

# --- Object storage for photos (S3-compatible). Empty = local disk (ephemeral on most hosts). ---
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Optional: geocoding (Mapbox token) so contractor matching can use distance. ---
GEOCODE_API_KEY=

# --- Email events (bounces/complaints -> suppression list) ---
# Shared secret for https://YOUR-DOMAIN/api/email/events?key=<this value>
SENDGRID_WEBHOOK_KEY=

# --- Optional error reporting: npm i @sentry/node, then set the DSN ---
SENTRY_DSN=

# --- Two-step verification (staff) ---
# REQUIRED for owner/finance areas in production. Set false only to turn the policy off.
REQUIRE_2FA=
# Key that encrypts 2FA secrets in the database. SET IT before anyone enrols, and keep it
# stable: if it changes, existing 2FA secrets become unreadable and must be reset.
TOTP_ENC_KEY=

# --- SMS (visit confirmation, day-before reminder, "technician on the way") ---
# Without these, texts are only written to the log (provider "console"). Customers must opt in.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use ONE of the next two:
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Business time zone: decides "tomorrow" and the 9:00-19:00 sending window.
BUSINESS_TZ=America/Los_Angeles

# --- Reply assistant for support staff (drafts only; a human always edits and sends) ---
# With OPENAI_API_KEY (above) set, drafts are written by the model; without it they are plain
# templates. Message text (emails/phones/addresses/links removed) is sent to the provider.
# Set AI_ENABLED=false to send NOTHING to any provider.
AI_ENABLED=
AI_MODEL=gpt-4o-mini
# Drafts each person may request per hour (cost/abuse guard).
AI_DRAFTS_PER_HOUR=30

# Rate limits (defaults: 20 auth attempts / 15 min / IP and 30 request submissions / hour / IP).
# Leave unset in production; the automated tests raise them.
AUTH_RATE_LIMIT_MAX=
INTAKE_RATE_LIMIT_MAX=
