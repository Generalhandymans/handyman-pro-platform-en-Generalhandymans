NODE_ENV=production
PORT=3000
PUBLIC_URL=https://app.generalhandymansolutions.com

# Database
DATABASE_URL=postgresql://user:password@host:5432/general_handyman
DB_SSL=true

# Session/Auth
JWT_SECRET=replace-with-64-plus-random-characters
COOKIE_DOMAIN=.generalhandymansolutions.com
COOKIE_SECURE=true
TRUST_PROXY=1

# Object storage (S3-compatible: AWS S3 or Cloudflare R2)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=general-handyman-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
HANDYMAN_FROM_EMAIL=operations@generalhandymansolutions.com
HANDYMAN_FROM_NAME=General Handyman Solutions

# AI
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL=
AI_ENABLED=true

# Observability
LOG_LEVEL=info
SENTRY_DSN=
