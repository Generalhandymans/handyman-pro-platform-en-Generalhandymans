# HELPMAN production environment template
NODE_ENV=production
PORT=10000

# Production DB: REQUIRED. Do not use ephemeral SQLite.
DATABASE_URL=
DB_SSL=true
PG_POOL_MAX=10

# Security
JWT_SECRET=
PUBLIC_URL=https://helpman.app
TRUST_PROXY=true

# Brand email
HANDYMAN_FROM_EMAIL=
HANDYMAN_FROM_NAME=HELPMAN
EMAIL_PROVIDER=
SENDGRID_API_KEY=

# Payments
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# AI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_SCOPE_MODEL=gpt-4o-mini

# Object storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Service areas
SERVICE_ZIPS=
SERVICE_ZIP_PREFIXES=

# Analytics
GA4_MEASUREMENT_ID=
GOOGLE_TAG_MANAGER_ID=
GOOGLE_SITE_VERIFICATION=

# Release
APP_VERSION=
GIT_SHA=
